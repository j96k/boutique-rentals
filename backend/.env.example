# Copy this file to ".env".
# Database: "sqlite" = the file backend/database/rental_cloth.db (default, no server needed)
#           "mysql"  = a MySQL server, using the DB_* values below
#           "postgres" = online PostgreSQL (Neon), using DATABASE_URL below
DB_TYPE=sqlite

# --- only used when DB_TYPE=mysql ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=rental_cloth_db

# --- only used when DB_TYPE=postgres (on Render this is set in the dashboard, not here) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30
